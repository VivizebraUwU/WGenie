<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MailoV2</title>
    <link rel="stylesheet" href="theme.css">
    <link rel="stylesheet" href="MailoV2.css">
</head>
<body>
    <div class="mailo-shell">
        <div class="mailo-row mailo-row-header">
            <section class="mailo-status" aria-live="polite">
                <div class="mailo-status-text" id="statusText">Please select a folder with templates</div>
            </section>
            <button class="mailo-button" id="resetButton" type="button">Reset</button>
        </div>

        <section class="mailo-row mailo-row-four" aria-label="Template navigation">
            <button class="mailo-button" id="previousButton" type="button">Previous</button>
            <button class="mailo-button" id="browseButton" type="button">Browse Templates</button>
            <button class="mailo-button" id="nextButton" type="button">Next</button>
            <button class="mailo-button" id="showPreviewButton" type="button">Show preview</button>
            <div class="mailo-file" id="templatesFolderText">No templates folder selected</div>
        </section>

        <section class="mailo-row" aria-label="Subject file selection">
            <button class="mailo-button" id="subjectButton" type="button">Select Subject File</button>
            <div class="mailo-file" id="subjectFileText">No subject file selected</div>
        </section>

        <section class="mailo-row" aria-label="Template selection">
            <button class="mailo-button" id="openTemplatesButton" type="button">Open Templates Browser</button>
            <button class="mailo-button" id="useCurrentUrlButton" type="button">Use Current Page</button>
        </section>

        <section class="mailo-row mailo-row-reference" aria-label="Template URL or name">
            <input class="mailo-input" id="templateReferenceInput" type="text" placeholder="Template URL (session) or template name (Tools API)" spellcheck="false" autocomplete="off">
            <button class="mailo-button" id="useTemplateReferenceButton" type="button">Use Template</button>
        </section>

        <section class="mailo-status" aria-live="polite">
            <div class="mailo-status-text" id="templateSummary">No template selected</div>
        </section>

        <section class="mailo-row mailo-row-actions" aria-label="Mail actions">
            <button class="mailo-button mailo-button-primary" id="selectTemplateButton" type="button">Select Template</button>
            <button class="mailo-button" id="copyLinkButton" type="button">Copy Link</button>
            <button class="mailo-button" id="refreshButton" type="button">Refresh Preview</button>
        </section>

        <section class="mailo-row" aria-label="Bindings">
            <button class="mailo-button" id="bindingsButton" type="button">Update Bindings</button>
        </section>

        <section class="mailo-options" aria-label="Localization options">
            <div class="mailo-options-title">Localization</div>
            <label class="mailo-toggle">
                <input type="checkbox" id="sendEnglishAsAllContentToggle">
                <span>Send en as All &mdash; email content</span>
            </label>
            <label class="mailo-toggle">
                <input type="checkbox" id="sendEnglishAsAllBindingsToggle">
                <span>Send en as All &mdash; bindings</span>
            </label>
            <div class="mailo-options-help">
                Uploads the English entry with an empty "lang" (PRM's catch-all) instead of "en".
                Content comes from en.html, bindings from the subject Excel &mdash; each can be switched separately.
                The bindings toggle also applies to Update Bindings.
            </div>
        </section>

        <section class="mailo-log" aria-label="PRM output log">
            <div class="mailo-log-title">PRM output log</div>
            <pre class="mailo-log-body" id="prmLog">No send attempted yet.</pre>
        </section>
    </div>

    <script src="MailoV2.js"></script>
</body>
</html>
