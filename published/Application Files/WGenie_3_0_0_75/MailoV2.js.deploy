document.addEventListener("DOMContentLoaded", function () {
    var storageKey = "form3-theme";
    var root = document.documentElement;
    var statusText = document.getElementById("statusText");
    var resetButton = document.getElementById("resetButton");
    var templatesFolderText = document.getElementById("templatesFolderText");
    var subjectFileText = document.getElementById("subjectFileText");
    var previousButton = document.getElementById("previousButton");
    var browseButton = document.getElementById("browseButton");
    var nextButton = document.getElementById("nextButton");
    var showPreviewButton = document.getElementById("showPreviewButton");
    var subjectButton = document.getElementById("subjectButton");
    var openTemplatesButton = document.getElementById("openTemplatesButton");
    var useCurrentUrlButton = document.getElementById("useCurrentUrlButton");
    var templateReferenceInput = document.getElementById("templateReferenceInput");
    var useTemplateReferenceButton = document.getElementById("useTemplateReferenceButton");
    var templateSummary = document.getElementById("templateSummary");
    var selectTemplateButton = document.getElementById("selectTemplateButton");
    var copyLinkButton = document.getElementById("copyLinkButton");
    var refreshButton = document.getElementById("refreshButton");
    var bindingsButton = document.getElementById("bindingsButton");
    var sendEnglishAsAllContentToggle = document.getElementById("sendEnglishAsAllContentToggle");
    var sendEnglishAsAllBindingsToggle = document.getElementById("sendEnglishAsAllBindingsToggle");
    var prmLog = document.getElementById("prmLog");
    var currentState = null;

    applyTheme(loadInitialTheme());
    bindEvents();
    render();

    window.addEventListener("message", function (event) {
        if (!event || !event.data) {
            return;
        }

        if (event.data.type === "form3-theme") {
            applyTheme(event.data.themeName || "dark");
            return;
        }

        if (event.data.type === "mailo-state") {
            currentState = event.data.state || null;
            render();
        }
    });

    window.requestAnimationFrame(function () {
        postToParent({
            type: "mailo-ready"
        });
        postAction("request-state");
    });

    function bindEvents() {
        // Form3 asks for confirmation before forwarding this to the host.
        resetButton.addEventListener("click", function () {
            postAction("reset");
        });

        browseButton.addEventListener("click", function () {
            postAction("browse-folder");
        });

        previousButton.addEventListener("click", function () {
            postAction("previous-template");
        });

        nextButton.addEventListener("click", function () {
            postAction("next-template");
        });

        showPreviewButton.addEventListener("click", function () {
            tracePreview("bindEvents", {
                step: "showPreviewButton-click"
            });
            postAction("show-preview");
        });

        subjectButton.addEventListener("click", function () {
            postAction("select-subject-file");
        });

        openTemplatesButton.addEventListener("click", function () {
            postAction("open-templates");
        });

        useCurrentUrlButton.addEventListener("click", function () {
            postAction("use-current-browser-url");
        });

        // A typed template URL sends with the tools session; a typed name through the Tools API.
        useTemplateReferenceButton.addEventListener("click", function () {
            postAction("use-template-reference");
        });

        templateReferenceInput.addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                postAction("use-template-reference");
            }
        });

        selectTemplateButton.addEventListener("click", function () {
            postAction("primary-action");
        });

        copyLinkButton.addEventListener("click", function () {
            postAction("copy-link");
        });

        refreshButton.addEventListener("click", function () {
            postAction("refresh-preview");
        });

        bindingsButton.addEventListener("click", function () {
            postAction("update-bindings");
        });

        // "update-options" only carries the toggles across; the host stores them and pushes state back.
        [sendEnglishAsAllContentToggle, sendEnglishAsAllBindingsToggle].forEach(function (toggle) {
            if (toggle) {
                toggle.addEventListener("change", function () {
                    postAction("update-options");
                });
            }
        });
    }

    function render() {
        var state = currentState || {};
        statusText.textContent = getText(state.StatusText, "Please select a folder with templates");
        templatesFolderText.textContent = typeof state.TemplatesFolderPath === "string" && state.TemplatesFolderPath.length > 0
            ? "Templates folder: " + state.TemplatesFolderPath
            : "No templates folder selected";
        subjectFileText.textContent = typeof state.SubjectFilePath === "string" && state.SubjectFilePath.length > 0
            ? "Subject file: " + state.SubjectFilePath
            : "No subject file selected";
        selectTemplateButton.textContent = getText(state.PrimaryActionLabel, "Select Template");

        var selectedUrl = typeof state.SelectedTemplateUrl === "string" ? state.SelectedTemplateUrl : "";
        templateSummary.textContent = selectedUrl.length > 0
            ? "Selected template: " + selectedUrl
            : "No template selected. Open Templates Browser and Use Current Page, or type a template URL or name.";

        // Mirror the selection into the field, but never overwrite what the user is typing.
        if (templateReferenceInput && document.activeElement !== templateReferenceInput) {
            templateReferenceInput.value = selectedUrl;
        }

        setToggle(sendEnglishAsAllContentToggle, state.SendEnglishAsAllContent);
        setToggle(sendEnglishAsAllBindingsToggle, state.SendEnglishAsAllBindings);

        renderPrmLog(state);
    }

    function setToggle(toggle, value) {
        if (!toggle || document.activeElement === toggle) {
            return;
        }

        toggle.checked = !!value;
    }

    function renderPrmLog(state) {
        if (!prmLog) {
            return;
        }

        var logText = typeof state.PrmLog === "string" ? state.PrmLog : "";
        var hasEntries = logText.length > 0;

        prmLog.textContent = hasEntries ? logText : "No send attempted yet.";
        prmLog.classList.toggle("is-error", hasEntries && !!state.PrmLogIsError);
        prmLog.classList.toggle("is-success", hasEntries && !state.PrmLogIsError);

        // Keep the newest entry in view.
        prmLog.scrollTop = prmLog.scrollHeight;
    }

    function postAction(action) {
        if (action === "show-preview") {
            tracePreview("postAction", {
                action: action
            });
        }

        postToParent({
            type: "mailo-action",
            action: action,
            options: collectOptions()
        });
    }

    function collectOptions() {
        return {
            sendEnglishAsAllContent: !!(sendEnglishAsAllContentToggle && sendEnglishAsAllContentToggle.checked),
            sendEnglishAsAllBindings: !!(sendEnglishAsAllBindingsToggle && sendEnglishAsAllBindingsToggle.checked),
            templateReference: templateReferenceInput ? templateReferenceInput.value : ""
        };
    }

    function postToParent(message) {
        if (!window.parent || window.parent === window) {
            return;
        }

        window.parent.postMessage(message, "*");
    }

    function loadInitialTheme() {
        try {
            return window.localStorage.getItem(storageKey) === "light" ? "light" : "dark";
        } catch (error) {
            return "dark";
        }
    }

    function applyTheme(themeName) {
        root.setAttribute("data-theme", themeName === "light" ? "light" : "dark");
    }

    function getText(value, fallback) {
        return typeof value === "string" && value.length > 0 ? value : fallback;
    }

    function tracePreview(methodName, details) {
        var parts = ["[MailoV2][JS]", methodName];
        var keys = Object.keys(details || {});

        keys.forEach(function (key) {
            parts.push(key + "=" + formatTraceValue(details[key]));
        });

        var message = parts.join(" ");
        console.log(message);
        postToParent({
            type: "mailo-preview-trace",
            message: message
        });
    }

    function formatTraceValue(value) {
        if (value === null) {
            return "null";
        }

        if (value === undefined) {
            return "undefined";
        }

        if (typeof value === "string") {
            return "\"" + value.replace(/"/g, "'") + "\"";
        }

        return String(value);
    }
});
